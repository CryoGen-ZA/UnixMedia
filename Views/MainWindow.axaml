<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UnixMedia.Views.MainWindow"
        Title="UnixMedia"
        Width="1280" Height="760" MinWidth="640" MinHeight="420"
        WindowState="FullScreen"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#0B1220" />
            <GradientStop Offset="0.6" Color="#111827" />
            <GradientStop Offset="1" Color="#1E1B4B" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Styles>
        <!-- TV-style tile: custom template so Fluent hover/press visuals don't interfere. -->
        <Style Selector="Button.tile">
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="170" />
            <Setter Property="Margin" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            BorderThickness="4"
                            BorderBrush="Transparent"
                            ClipToBounds="True"
                            BoxShadow="0 6 18 0 #66000000">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ Border#PART_Frame">
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
        </Style>
        <Style Selector="Button.tile:focus">
            <Setter Property="RenderTransform" Value="scale(1.08)" />
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="Button.tile:focus /template/ Border#PART_Frame">
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BoxShadow" Value="0 10 30 4 #AA000000" />
        </Style>
        <Style Selector="Button.tile:pressed">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <!-- Settings (gear) button in the top bar -->
        <Style Selector="Button#SettingsButton">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button#SettingsButton:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Background" Value="#44FFFFFF" />
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="260" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="48,32,48,8" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="UnixMedia" FontSize="34" FontWeight="Bold" Foreground="White" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                <Button x:Name="SettingsButton" ToolTip.Tip="Settings">
                    <TextBlock Text="⚙" FontSize="28" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem x:Name="AddTileItem" Header="Add tile" InputGesture="A" />
                            <MenuItem x:Name="KioskItem" Header="Open websites fullscreen (kiosk)"
                                      ToggleType="CheckBox" />
                            <MenuItem x:Name="SoundsItem" Header="Sounds" ToggleType="CheckBox" />
                            <MenuItem x:Name="IntroItem" Header="Intro animation" ToggleType="CheckBox" />
                            <Separator />
                            <MenuItem x:Name="PowerItem" Header="Power…" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <StackPanel>
                    <TextBlock x:Name="ClockText" FontSize="34" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                    <TextBlock x:Name="DateText" FontSize="15" Foreground="#94A3B8" HorizontalAlignment="Right" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Tiles -->
        <ScrollViewer Grid.Row="1" x:Name="TileScroller"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="32,16">
            <WrapPanel x:Name="TilePanel" Orientation="Horizontal"
                       ItemsAlignment="Center"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center" />
        </ScrollViewer>

        <!-- Bottom hint bar + toast -->
        <Grid Grid.Row="2" Margin="48,8,48,24" ColumnDefinitions="*,Auto">
            <TextBlock FontSize="14" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Arrows: navigate   ·   Enter: open   ·   S / Esc: settings   ·   E / right-click: edit   ·   Delete: remove   ·   Ctrl+←/→: reorder   ·   F11: fullscreen" />
            <Border Grid.Column="1" x:Name="Toast" IsVisible="False" Background="#DC2626"
                    CornerRadius="8" Padding="16,8" MaxWidth="520">
                <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
